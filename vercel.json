{
  "framework": null,
  "buildCommand": "npm install --prefix frontend && npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/etudiants",
      "destination": "/api/etudiants.js"
    },
    {
      "source": "/api/rapports",
      "destination": "/api/rapports.js"
    },
    {
      "source": "/api/parent/enfants",
      "destination": "/api/parent/enfants.js"
    },
    {
      "source": "/api/inscription",
      "destination": "/api/inscription.js"
    },
    {
      "source": "/api/bio/face",
      "destination": "/api/bio/face.js"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/auth/login.js"
    },
    {
      "source": "/api/utilisateurs",
      "destination": "/api/utilisateurs.js"
    },
    {
      "source": "/api/rh/pointages",
      "destination": "/api/rh/pointage"
    },
    {
      "source": "/api/rh/pointage/arrivee",
      "destination": "/api/rh/pointage?action=arrivee"
    },
    {
      "source": "/api/rh/pointage/depart",
      "destination": "/api/rh/pointage?action=depart"
    },
    {
      "source": "/api/visio",
      "destination": "/api/visio.js"
    }
  ]
}